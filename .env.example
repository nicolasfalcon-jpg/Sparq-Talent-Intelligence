# Data source: "memory" uses the fictional in-memory repository (default).
# "supabase" is reserved for phase 2 (not implemented yet).
SPARQ_DATA_SOURCE=memory

# Phase 2 — Supabase (leave empty until the project exists)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — Ask Sparq LLM gateway (server-side only; never expose to the browser)
SPARQ_ASSISTANT_PROVIDER=illustrative
