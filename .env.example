# =====================================================================================================================
# APPLICATION RUNTIME  (.env.local, or the Vercel project's environment variables)
# These are the ONLY variables the application reads. No administrative credential belongs here.
# =====================================================================================================================

# "memory": fictional in-process fixtures + the DEMO persona cookie. Local development and isolated tests ONLY.
# "supabase": Supabase PostgreSQL + Auth (real login, request-scoped user JWT, row-level security).
# A deployed environment (Vercel) REFUSES "memory": set supabase there.
SPARQ_DATA_SOURCE=memory

# Supabase project (public values: the browser may know them; row-level security is the protection)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ask Sparq (server-side only; never expose to the browser)
ANTHROPIC_API_KEY=
SPARQ_ASSISTANT_MODEL=claude-sonnet-5-5
# Calls per user per day (1..1000), enforced in the database with the user's own JWT
SPARQ_ASSISTANT_DAILY_LIMIT=40

# =====================================================================================================================
# ADMIN-ONLY  (.env.admin.local, gitignored: read ONLY by scripts/db/* and tests/remote/*, NEVER by the application)
# See docs/handoff/09-supabase-setup.md. Never set these on Vercel.
# =====================================================================================================================

# Postgres connection string of the dedicated FICTIONAL-data project (session pooler or direct), used by `npm run db:migrate`
SUPABASE_DB_URL=
# Service-role key, used only by `npm run db:provision` (creates the demo accounts) and by the remote tests' setup
SUPABASE_SERVICE_ROLE_KEY=
# Safety lock: must equal the project ref (the <ref> in https://<ref>.supabase.co). Nothing remote runs without it.
SPARQ_CONFIRM_FICTIONAL_PROJECT=
